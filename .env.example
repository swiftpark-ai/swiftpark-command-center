DISCORD_BOT_TOKEN=replace-with-discord-bot-token
DISCORD_CLIENT_ID=replace-with-discord-application-client-id
DISCORD_GUILD_ID=replace-with-discord-server-id
ALLOWED_DISCORD_USER_IDS=replace-with-your-discord-user-id

SWIFTPARK_REPO_PATH=/path/to/swiftpark
WORKTREES_DIR=/path/to/swiftpark-worktrees
RUNS_DIR=/path/to/swiftpark-command-center/runs
DISPATCHER_BASE_REF=origin/main

QA_COMMAND=npm run qa
QA_DASHBOARD_COMMAND=npm run qa:dashboard
COMMAND_TIMEOUT_MS=0
ORION_PLANNING_TIMEOUT_MS=0
AGENT_MAX_RUNTIME_MS=0
IRIS_MAX_RUNTIME_MS=0
ATLAS_MAX_RUNTIME_MS=0
SENTINEL_MAX_RUNTIME_MS=0
ORION_STALE_AFTER_MS=300000
AGENT_STALE_AFTER_MS=600000
AGENT_HEARTBEAT_MS=45000
ORION_THREAD_REPLIES_ENABLED=false
QA_MAX_SCREENSHOT_UPLOADS=30
QA_DEFAULT_SCREENSHOT_UPLOAD_CAP=6
AGENT_LOG_DISCORD_CHUNKS=2

PULSE_TIME_ZONE=America/Los_Angeles
PULSE_GYM_PROMPT_HOUR=12
PULSE_GYM_PROMPT_MINUTE=0

GITHUB_STATUS_ENABLED=false
GITHUB_ISSUES_ENABLED=false
COMMAND_CENTER_GITHUB_ISSUES_ENABLED=false

JIRA_ENABLED=false
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_BOARD_ID=

MANUAL_LOG_EXTERNAL_POSTING_ENABLED=false
